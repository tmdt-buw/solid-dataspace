{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "environment",
    "domains",
    "public"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "environment": {
      "enum": [
        "prod",
        "test"
      ]
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9.-]+$"
      }
    },
    "public": {
      "type": "object",
      "required": [
        "dataspaceId",
        "branding",
        "apps",
        "catalog",
        "statistics",
        "syncWorker",
        "plasmaUrl"
      ],
      "properties": {
        "accessGateway": {
          "type": "boolean"
        }
      }
    },
    "administration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "adminWebIds"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "adminWebIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          }
        }
      }
    },
    "redirectDomains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9.-]+$"
      }
    }
  }
}
