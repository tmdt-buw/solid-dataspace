# Copy to .env.local. Use --env-file .env.local so server .env values are not loaded.
LOCAL_HTTP_PORT=8080
# Relative to this repository, or absolute paths (forward slashes also on Windows).
HEALTH_SOURCE=../solid-health-app
WORKER_SOURCE=../solid-data-connection-sync-worker

# Sign in to this public Solid provider with your own test account.
LOCAL_ISSUER=https://solid-community-server.tmdt.info
# Only needed for worker synchronization, not for opening the UI or editing Health App.
# Use YOUR test worker identity and its client credentials. No server credentials.
SOLID_SYNC_WORKER_WEBID=
SOLID_SYNC_WORKER_CLIENT_ID=
SOLID_SYNC_WORKER_CLIENT_SECRET=
LOCAL_SYNC_TICK_SECONDS=600

# Optional administrator of locally created import templates (exact WebIDs).
LOCAL_ADMIN_WEBIDS_JSON=[]
# Optional public registry/cache for local catalog and monitoring tests.
LOCAL_REGISTRY_URL=
LOCAL_PUBLIC_CACHE_ENABLED=false
LOCAL_REGISTRIES_JSON=[]

# Enable the corresponding Compose profile as well as the navigation entry.
LOCAL_PLASMA_ENABLED=false
LOCAL_NODERED_ENABLED=false
LOCAL_PLASMA_TAG=sha-7ae77d7baab4
# DATASPACE_ID=test and WORKER_CONNECTION_NAMESPACE=test are fixed by the local override.
# Keys are generated once in a local Docker volume. No NPM_TOKEN is needed for this mode.
