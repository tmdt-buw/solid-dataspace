# Package access used by the local development stack.
NPM_TOKEN=

# Manager sidebar visibility. Use the lowercase JSON boolean false to hide an
# app without disabling its container or direct standalone route.
SOLID_TOURS_VISIBLE=true
SOLID_HEALTH_QUESTIONNAIRE_VISIBLE=true

# Local PLASMA sibling integration.
PLASMA_VERSION=1.8.1
PLASMA_PUBLIC_URL=/plasma/modelings
# Required by docker-compose.plasma.yml on deployed instances.
PLASMA_DB_PASSWORD=
PLASMA_DB_ROOT_PASSWORD=
PLASMA_FUSEKI_ADMIN_PASSWORD=

# Existing Solid service identity. Create/rotate credentials for this same WebID;
# the statistics feature does not need a second service account.
SOLID_SYNC_WORKER_WEBID=https://solid-community-server.tmdt.info/solidserviceworker/profile/card#me
SOLID_SYNC_WORKER_OIDC_ISSUER=https://solid-community-server.tmdt.info
SOLID_SYNC_WORKER_CLIENT_ID=
SOLID_SYNC_WORKER_CLIENT_SECRET=
SOLID_SYNC_WORKER_DB_SECRET=

# Multi-user Solid Tours scenario. When the dedicated registry list stays empty,
# the worker reuses STATISTICS_REGISTRIES_JSON. The fixed source below remains a
# backward-compatible fallback only when no registry is configured.
ENVIRONMENTAL_SCENARIO_ENABLED=true
ENVIRONMENTAL_SCENARIO_POLL_SECONDS=30
ENVIRONMENTAL_SCENARIO_REGISTRIES_JSON=
# Registry ID used by this Dataspace Manager instance when loading the
# Environmental Monitoring aggregate (for example stadt-wuppertal, dace or
# timberconnect).
# Set this explicitly for every production instance. When it is empty and no
# STATISTICS_REGISTRY_CONTEXT is configured, the embedded app fails closed and
# does not fall back to a combined aggregate. The local TMDT development stack
# defaults to the Gesundes Tal partition shown below.
ENVIRONMENTAL_SCENARIO_DATASPACE_ID=stadt-wuppertal
# Public route aggregates require at least this many distinct WebIDs per route
# and activity type. Direct identifiers are removed, but this is not a formal
# anonymity guarantee for route locations.
ENVIRONMENTAL_SCENARIO_MIN_DONORS_PER_ROUTE=2
ENVIRONMENTAL_SCENARIO_MAX_REGISTRIES_PER_POLL=8
ENVIRONMENTAL_SCENARIO_MAX_REGISTRY_ENTRIES_PER_POLL=64
ENVIRONMENTAL_SCENARIO_MAX_REGISTRY_MEMBERS_PER_POLL=32
ENVIRONMENTAL_SCENARIO_DISCOVERY_TIMEOUT_MS=25000
ENVIRONMENTAL_SCENARIO_OWNER_WEBID=https://solid-community-server.tmdt.info/sscon/profile/card#me
ENVIRONMENTAL_SCENARIO_MARKER_URL=https://solid-community-server.tmdt.info/sscon/solid-tours/public/current-run.json
ENVIRONMENTAL_SCENARIO_DATA_URL_PREFIX=https://solid-community-server.tmdt.info/sscon/solid-tours/runs/
ENVIRONMENTAL_SCENARIO_MAX_BYTES=2097152

# Statistics are stored as Solid resources, never in the worker's SQLite file.
# Enable only after the service credentials and STATISTICS_HMAC_SECRET are set.
STATISTICS_ENABLED=false
STATISTICS_POD_BASE_URL=https://solid-community-server.tmdt.info/solidtestpod/statistics/
# Optional event target override for the Test instance represented by this root
# stack. Leave blank to derive its leaf URL from STATISTICS_POD_BASE_URL.
STATISTICS_EVENTS_URL=
# Optional worker source override. Leave blank to derive all four configured
# instance leaf URLs from STATISTICS_POD_BASE_URL in Docker Compose.
STATISTICS_EVENT_SOURCES_JSON=
# Read the former events/downloads/ container during migration as well.
STATISTICS_INCLUDE_LEGACY_EVENT_SOURCE=true
STATISTICS_ADMIN_WEBIDS_JSON=["https://solid-community-server.tmdt.info/solidtestpod/profile/card#me"]
# Required in enabled deployments. Use a new random value with at least 32 bytes.
STATISTICS_HMAC_SECRET=
STATISTICS_HMAC_VERSION=v1
STATISTICS_REGISTRIES_JSON=[{"id":"stadt-wuppertal","label":"Gesundes Tal","url":"https://solid-community-server.tmdt.info/semanticdatacatalog/public/stadt-wuppertal"},{"id":"dace","label":"DACE","url":"https://solid-community-server.tmdt.info/semanticdatacatalog/public/dace"},{"id":"timberconnect","label":"TimberConnect","url":"https://solid-community-server.tmdt.info/semanticdatacatalog/public/timberconnect"},{"id":"test","label":"Test","url":"https://solid-community-server.tmdt.info/semanticdatacatalog/public/test"}]
STATISTICS_REFRESH_INTERVAL_MINUTES=15
STATISTICS_TIMEZONE=Europe/Berlin
STATISTICS_ACTIVITY_RESOURCE_PATH=statistics/activity/activity.ttl
STATISTICS_RETENTION_MONTHS=24
STATISTICS_RAW_EVENT_RETENTION_DAYS=90
STATISTICS_REQUEST_TIMEOUT_MS=20000
STATISTICS_REGISTRY_CONTEXT=

# Catalog backend service identity.
CATALOG_SERVICE_WEBID=https://solid-community-server.tmdt.info/solidservice/profile/card#me
CATALOG_SERVICE_OIDC_ISSUER=https://solid-community-server.tmdt.info
CATALOG_SERVICE_CLIENT_ID=
CATALOG_SERVICE_CLIENT_SECRET=
